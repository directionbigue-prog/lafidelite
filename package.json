{
  "name": "coeur-fidele",
  "version": "0.0.1",
  "private": true,
  "description": "Cœur Fidèle — jeu de couple à deux joueurs, monolithe Next.js 16 (App Router : Route Handlers + Server Actions) + Prisma + auth cookie/CSRF/JWT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev --port 3000 --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prisma-cli.ts db push",
    "db:migrate:dev": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prisma-cli.ts migrate dev",
    "db:migrate:deploy": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prisma-cli.ts migrate deploy",
    "db:migrate:status": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prisma-cli.ts migrate status",
    "db:migrate:reset": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prisma-cli.ts migrate reset",
    "db:studio": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prisma-cli.ts studio",
    "db:make-superadmin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/make-superadmin.ts",
    "seed:dev": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "seed:questions": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-questions.ts",
    "seed:game-couple": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-game-couple.ts",
    "smoke:auth": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-auth.ts",
    "smoke:game": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-game.ts",
    "drain": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/drain-queues.ts",
    "code": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev-code.ts",
    "abonner": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/grant-pack.ts",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4": "^5.0.11",
      "fast-uri": "^3.1.7",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.18",
      "browserslist": "^4.28.7",
      "source-map-js": "^1.2.2"
    }
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.93.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.52.0",
    "@upstash/redis": "^1.34.3",
    "@vercel/otel": "^2.1.2",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.3",
    "next": "^16.3.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^20.17.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.8",
    "fast-glob": "^3.3.3",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "postcss": "^8.5.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.7",
    "vitest-mock-extended": "^3.1.1"
  }
}
